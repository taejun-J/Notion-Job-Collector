# Create a Notion integration, share both databases with it, and store the
# token as a GitHub Actions secret named NOTION_TOKEN.
NOTION_TOKEN=secret_replace_me

# These IDs already point to the databases created in Career Hub.
NOTION_JOB_DATA_SOURCE_ID=fe880847-c020-4c66-b8d4-840cfa4bbb6a
NOTION_COMPANIES_DATA_SOURCE_ID=95eedd44-631c-4f96-a18e-08f470709d96
NOTION_API_VERSION=2026-03-11

# Optional: a public JSON feed URL consumed by the generic adapter.
JOB_FEED_URL=

